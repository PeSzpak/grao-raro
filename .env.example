DATABASE_URL=mysql://graoraro:graoraro@127.0.0.1:3307/graoraro

# Chave da conta real do Asaas. Nunca commitar.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
# Token que o Asaas envia no header asaas-access-token do webhook
ASAAS_WEBHOOK_TOKEN=

ADMIN_PASSWORD=
SESSION_SECRET=
# Agendador da Vercel envia "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Endereço público do site, usado no retorno da fatura do débito
SITE_URL=
# Libera pagamento real de todos os produtos, não só da amostra. Desligado por padrão.
ALLOW_REAL_CHECKOUT_ALL=false
